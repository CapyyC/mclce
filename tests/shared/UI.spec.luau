local CraftingModel = require("../../src/shared/UI/CraftingModel")
local FocusGrid = require("../../src/shared/UI/FocusGrid")
local MenuModel = require("../../src/shared/UI/MenuModel")
local Inventory = require("../../src/shared/Items/Inventory")
local ItemStack = require("../../src/shared/Items/ItemStack")

return function(t)
	t.describe("CraftingModel", function()
		t.test("tabs cycle with wrap; craftable recipes sort first; grid filters", function()
			local inv = Inventory.new()
			Inventory.add(inv, ItemStack.new(5, 8)) -- planks
			local m = CraftingModel.new(2)
			CraftingModel.refresh(m, inv)
			t.eq(m.tabs[m.tab], "structures")
			local first = CraftingModel.selected(m)
			t.truthy(first and first.craftable, "crafting table craftable")
			t.eq(first.recipe.name, "crafting_table")
			for _, e in m.entries do
				t.truthy(e.recipe.grid <= 2, "2x2 grid only")
			end
			CraftingModel.input(m, "tabPrev", inv)
			t.eq(m.tabs[m.tab], "materials", "wraps backwards")
			CraftingModel.input(m, "tabNext", inv)
			CraftingModel.input(m, "tabNext", inv)
			t.eq(m.tabs[m.tab], "tools")
			local m3 = CraftingModel.new(3)
			m3.tab = 2
			CraftingModel.refresh(m3, inv)
			t.truthy(#m3.entries >= 25, "all tools listed at a table")
			local anyCraftable = false
			for _, e in m3.entries do
				anyCraftable = anyCraftable or e.craftable
			end
			t.falsy(anyCraftable, "no sticks -> nothing craftable, but still listed")
		end)
		t.test("left/right wrap within the tab", function()
			local inv = Inventory.new()
			local m = CraftingModel.new(3)
			CraftingModel.refresh(m, inv)
			local n = #m.entries
			CraftingModel.input(m, "left", inv)
			t.eq(m.index, n)
			CraftingModel.input(m, "right", inv)
			t.eq(m.index, 1)
		end)
	end)
	t.describe("FocusGrid", function()
		t.test("inventory layout navigation (storage -> hotbar, wraps in row)", function()
			local g = FocusGrid.new(FocusGrid.inventoryLayout())
			t.truthy(FocusGrid.focusId(g, 10))
			FocusGrid.move(g, "down")
			FocusGrid.move(g, "down")
			FocusGrid.move(g, "down")
			t.eq(FocusGrid.focused(g).id, 1, "column 0 of the hotbar")
			FocusGrid.move(g, "left")
			t.eq(FocusGrid.focused(g).id, 9, "wraps to the end of the row")
			FocusGrid.move(g, "up")
			t.eq(FocusGrid.focused(g).id, 36)
			t.falsy(FocusGrid.move(g, "sideways"))
		end)
		t.test("player layout: armour column above storage", function()
			local g = FocusGrid.new(FocusGrid.playerLayout())
			FocusGrid.focusId(g, 40)
			FocusGrid.move(g, "down")
			t.eq(FocusGrid.focused(g).id, 10)
			FocusGrid.move(g, "up")
			t.eq(FocusGrid.focused(g).id, 40)
			FocusGrid.move(g, "up")
			t.eq(FocusGrid.focused(g).id, 39)
		end)
		t.test("container rows sit above the inventory", function()
			local g = FocusGrid.new(FocusGrid.inventoryLayout(27))
			FocusGrid.focusId(g, "c27")
			FocusGrid.move(g, "down")
			t.eq(FocusGrid.focused(g).id, 18, "below the last chest slot is storage column 8")
			FocusGrid.focusId(g, "c1")
			t.falsy(FocusGrid.move(g, "up"))
		end)
	end)
	t.describe("MenuModel", function()
		t.test("pause menu navigation and resume", function()
			local m = MenuModel.new()
			t.truthy(MenuModel.isGameplay(m))
			MenuModel.input(m, "pause")
			t.eq(MenuModel.top(m).name, "pause")
			MenuModel.input(m, "up")
			t.eq(MenuModel.top(m).focus, #MenuModel.PAUSE_ITEMS, "wraps to the last item")
			MenuModel.input(m, "down")
			t.eq(MenuModel.input(m, "confirm"), "resume")
			t.truthy(MenuModel.isGameplay(m))
			t.deepEq(MenuModel.takeEvents(m), { "open:pause", "close:pause" })
		end)
		t.test("inventory toggles; back closes; server screens override", function()
			local m = MenuModel.new()
			MenuModel.input(m, "inventory")
			t.eq(MenuModel.top(m).name, "inventory")
			MenuModel.input(m, "pause") -- ignored while in inventory
			t.eq(MenuModel.top(m).name, "inventory")
			MenuModel.input(m, "inventory")
			t.truthy(MenuModel.isGameplay(m))
			MenuModel.input(m, "crafting")
			MenuModel.force(m, "death")
			t.eq(MenuModel.top(m).name, "death")
			t.eq(#m.stack, 2)
			MenuModel.input(m, "back")
			t.eq(MenuModel.top(m).name, "death", "death screen ignores back")
		end)
		t.test("death screen only accepts respawn", function()
			local m = MenuModel.new()
			MenuModel.force(m, "death")
			t.eq(MenuModel.input(m, "pause"), nil)
			t.eq(MenuModel.top(m).name, "death")
			t.eq(MenuModel.input(m, "confirm"), "respawn")
		end)
	end)
end

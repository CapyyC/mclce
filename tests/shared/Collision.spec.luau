local Collision = require("../../src/shared/Physics/Collision")

local function grid(blocks)
	return function(x, y, z)
		return blocks[x .. "," .. y .. "," .. z] or 0
	end
end

return function(t)
	t.describe("Collision", function()
		local STONE = 16
		t.test("falling box lands on top of a block", function()
			local g = grid({ ["0,0,0"] = STONE })
			local b = Collision.box(0.5, 3, 0.5, 0.3, 1.8)
			local _, dy, _, _, hitY = Collision.move(g, b, 0, -10, 0)
			t.truthy(hitY)
			t.near(b.minY, 1, 1e-9)
			t.near(dy, -2, 1e-9)
		end)
		t.test("free fall without blocks", function()
			local b = Collision.box(0.5, 3, 0.5, 0.3, 1.8)
			local _, dy, _, _, hitY = Collision.move(grid({}), b, 0, -1.25, 0)
			t.falsy(hitY); t.near(dy, -1.25, 1e-12)
		end)
		t.test("walls stop horizontal motion (both directions, negative coords)", function()
			local g = grid({ ["-3,0,0"] = STONE, ["-3,1,0"] = STONE, ["2,0,-1"] = STONE, ["2,1,-1"] = STONE })
			local b = Collision.box(-1.5, 0, 0.5, 0.3, 1.8)
			local dx, _, _, hitX = Collision.move(g, b, -5, 0, 0)
			t.truthy(hitX); t.near(b.minX, -2, 1e-9); t.near(dx, -0.2, 1e-9)
			local b2 = Collision.box(0.5, 0, -0.5, 0.3, 1.8)
			Collision.move(g, b2, 5, 0, 0)
			t.near(b2.maxX, 2, 1e-9)
		end)
		t.test("ceiling stops upward motion", function()
			local g = grid({ ["0,3,0"] = STONE })
			local b = Collision.box(0.5, 0, 0.5, 0.3, 1.8)
			Collision.move(g, b, 0, 5, 0)
			t.near(b.maxY, 3, 1e-9)
		end)
		t.test("non-solid blocks are passable; slabs are half height", function()
			local g = grid({ ["0,0,0"] = 31 * 16, ["1,0,0"] = 44 * 16 })
			local b = Collision.box(0.5, 2, 0.5, 0.3, 1.8)
			Collision.move(g, b, 0, -5, 0)
			t.near(b.minY, -3, 1e-9)
			local s = Collision.box(1.5, 2, 0.5, 0.3, 1.8)
			Collision.move(g, s, 0, -5, 0)
			t.near(s.minY, 0.5, 1e-9)
		end)
		t.test("intersects", function()
			local g = grid({ ["0,1,0"] = STONE })
			t.truthy(Collision.intersectsBlocks(g, Collision.box(0.5, 0, 0.5, 0.3, 1.8)))
			t.falsy(Collision.intersectsBlocks(g, Collision.box(1.5, 0, 0.5, 0.3, 1.8)))
			t.falsy(Collision.intersectsBlocks(g, Collision.box(0.5, 2, 0.5, 0.3, 1.8)))
		end)
	end)
end

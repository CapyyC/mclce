local B = require("../../src/shared/Blocks/BlockRegistry")

return function(t)
	t.describe("BlockRegistry", function()
		t.test("classic numeric ids", function()
			t.eq(B.STONE, 1); t.eq(B.GRASS, 2); t.eq(B.DIRT, 3); t.eq(B.BEDROCK, 7)
			t.eq(B.WATER, 9); t.eq(B.LAVA, 11); t.eq(B.LOG, 17); t.eq(B.LEAVES, 18)
			t.eq(B.DIAMOND_ORE, 56); t.eq(B.idOf("crafting_table"), 58)
		end)
		t.test("air is not opaque, solid or known-occluding", function()
			t.falsy(B.occludes(0)); t.falsy(B.isSolid(0)); t.truthy(B.isReplaceable(0))
			t.eq(B.layer(0), B.LAYER_NONE)
		end)
		t.test("opaque/cutout/translucent classification", function()
			t.truthy(B.occludes(B.STONE))
			t.falsy(B.occludes(B.GLASS)); t.eq(B.layer(B.GLASS), B.LAYER_CUTOUT)
			t.falsy(B.occludes(B.LEAVES))
			t.eq(B.layer(B.WATER), B.LAYER_TRANSLUCENT)
			t.falsy(B.occludes(B.TALLGRASS)); t.falsy(B.isSolid(B.TALLGRASS))
			t.falsy(B.occludes(B.idOf("stone_slab")))
		end)
		t.test("state packing", function()
			local s = B.state(35, 14)
			t.eq(B.stateId(s), 35); t.eq(B.stateMeta(s), 14)
			t.eq(B.state(4095, 15), 65535)
		end)
		t.test("hardness facts", function()
			t.eq(B.hardness(B.STONE), 1.5); t.eq(B.hardness(B.BEDROCK), -1)
			t.eq(B.hardness(B.idOf("obsidian")), 50)
		end)
		t.test("unknown ids are safe", function()
			t.eq(B.get(4000), nil); t.falsy(B.occludes(4000)); t.eq(B.layer(4000), 0)
		end)
		t.test("light emission", function()
			t.eq(B.emission(B.TORCH), 14); t.eq(B.emission(B.idOf("glowstone")), 15); t.eq(B.emission(B.LAVA), 15)
		end)
	end)
end

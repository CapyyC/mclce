-- Scripted session: boot server, join one player, start the client, stream,
-- mine, place, shut down. Fails on any script error or broken expectation.
local mode = ({ ... })[1] or "parts"
print("[mock] renderer mode: " .. mode)
local H = require("./Harness")
local Mock = H.Mock
local check = H.check

print("[mock] boot server")
H.runScript("server", "src/server/Main.server.luau")
H.run(1)
local RS = H.services.ReplicatedStorage
check(RS:FindFirstChild("mclceC2S") ~= nil and RS:FindFirstChild("mclceS2C") ~= nil, "server created remotes")

H.services.Workspace:SetAttribute("mclceRenderer", mode)
print("[mock] player joins, client starts")
local player = H.addPlayer(1001, "alice")
H.run(0.5)
H.runScript("client", "src/client/Main.client.luau")
H.run(10)

for _, e in Mock.errors do
	print("SCRIPT ERROR (boot): " .. e)
end
local ws = H.services.Workspace
local worldFolder = ws:FindFirstChild("mclceWorld")
check(worldFolder ~= nil, "client created world folder")
local sections, parts, visible = 0, 0, 0
if worldFolder then
	for _, f in worldFolder:GetChildren() do
		sections += 1
		for _, p in f:GetChildren() do
			parts += 1
			if p.Transparency < 1 then
				visible += 1
			end
		end
	end
end
check(sections > 20, "collision/render sections: " .. sections)
check(parts > 100, "box parts: " .. parts)
if mode == "mesh" then
	check(parts < 8000, "collision boxes limited to near the player: " .. parts)
end
if mode == "mesh" then
	local meshFolder = ws:FindFirstChild("mclceMeshWorld")
	check(meshFolder ~= nil and #meshFolder:GetChildren() > 20, "mesh parts: " .. (meshFolder and #meshFolder:GetChildren() or 0) .. " (" .. H.meshStats.triangles .. " triangles)")
	check(visible == 0 or visible < parts * 0.05, "collision boxes are invisible (visible=" .. visible .. ")")
end
local root = player.Character.HumanoidRootPart
check(root.Anchored == false, "character unanchored after client HELLO")
check(player.PlayerGui:FindFirstChild("mclceHud") ~= nil, "HUD created")
check(Mock.enumEq(player.CameraMode, Mock.Enum.CameraMode.LockFirstPerson), "first-person camera")
check((H.trafficByKind[2] or 0) >= 50, "chunks streamed: " .. tostring(H.trafficByKind[2]))
do
	local sgs = H.sideG.server.mclceServer.gs
	check((sgs.stats.asyncRequested or 0) > 20, "chunks generated by parallel Actor workers: " .. tostring(sgs.stats.asyncRequested))
end

print("[mock] mine the block under the player, then place onto a neighbour")
local BS = 3
local gs = H.sideG.server.mclceServer.gs
local SWorld = H.caches.server["src/shared/Voxel/World.luau"]
local SInventory = H.caches.server["src/shared/Items/Inventory.luau"]
local SItemStack = H.caches.server["src/shared/Items/ItemStack.luau"]
local sp = gs.players[1001]
-- no physics in the mock: declare the character grounded (else mining is 5x slower)
player.Character.Humanoid.FloorMaterial = Mock.Enum.Material.Grass
local bx, by, bz = math.floor(sp.x), math.floor(sp.y), math.floor(sp.z)
SWorld.setState(gs.world, bx, by - 1, bz, 3 * 16) -- dirt under the feet
SWorld.setState(gs.world, bx + 1, by - 1, bz, 1 * 16) -- stone neighbour
SWorld.setState(gs.world, bx + 1, by, bz, 0)
SWorld.setState(gs.world, bx + 1, by + 1, bz, 0)
H.run(0.5)
local eye = Mock.Vector3.new(sp.x * BS, (sp.y + 1.62) * BS, sp.z * BS)
local camera = ws.CurrentCamera
camera.CFrame = Mock.CFrame.new(eye, Mock.Vector3.new(sp.x * BS, (by - 2) * BS, sp.z * BS))
local UIS = H.services.UserInputService
local MB1 = { UserInputType = Mock.Enum.UserInputType.MouseButton1, KeyCode = Mock.Enum.KeyCode.Unknown }
local MB2 = { UserInputType = Mock.Enum.UserInputType.MouseButton2, KeyCode = Mock.Enum.KeyCode.Unknown }
UIS.InputBegan:Fire(MB1, false)
H.run(2) -- dirt by hand: 0.75 s
UIS.InputEnded:Fire(MB1)
H.run(0.5)
check(SWorld.getId(gs.world, bx, by - 1, bz) == 0, "server accepted the timed break")
check(gs.items.count >= 1 or SInventory.count(sp.inventory, 3) >= 1, "dirt dropped")
SInventory.add(sp.inventory, SItemStack.new(4, 3))
sp.inventory.selected = 1
for i = 1, 9 do
	local s = sp.inventory.slots[i]
	if s and s.id == 4 then
		sp.inventory.selected = i
	end
end
sp.inventory.version += 1
H.run(0.3) -- inventory replicates to the client
camera.CFrame = Mock.CFrame.new(eye, Mock.Vector3.new((bx + 1.5) * BS, by * BS, (bz + 0.5) * BS))
UIS.InputBegan:Fire(MB2, false)
H.run(0.1)
UIS.InputEnded:Fire(MB2)
H.run(0.5)
check(SWorld.getId(gs.world, bx + 1, by, bz) == 4, "placed cobblestone on the neighbour's top face")
check(player.PlayerGui.mclceHud.Debug.Text ~= "", "HUD debug text: " .. player.PlayerGui.mclceHud.Debug.Text)

print("[mock] a pig appears; click it")
local SMobs = H.caches.server["src/shared/Sim/Mobs.luau"]
local SMobTypes = H.caches.server["src/shared/Sim/MobTypes.luau"]
for dx = -3, -1 do
	SWorld.setState(gs.world, bx + dx, by - 1, bz, 1 * 16)
	SWorld.setState(gs.world, bx + dx, by, bz, 0) -- no tall grass in the line of sight
	SWorld.setState(gs.world, bx + dx, by + 1, bz, 0)
end
local pig = SMobs.spawn(gs.mobs, SMobTypes.byName("pig"), bx - 1.5, by, bz + 0.5)
pig.wanderTicks = 100000
H.run(0.5)
local mobsFolder = ws:FindFirstChild("mclceMobs")
check(mobsFolder ~= nil and #mobsFolder:GetChildren() >= 1, "mob rendered on the client")
camera.CFrame = Mock.CFrame.new(eye, Mock.Vector3.new(pig.x * BS, (pig.y + 0.45) * BS, pig.z * BS))
UIS.InputBegan:Fire(MB1, false)
H.run(0.1)
UIS.InputEnded:Fire(MB1)
H.run(0.3)
check(pig.health < 10, "pig took melee damage (health " .. pig.health .. ")")

print("[mock] open a chest by right-clicking it, move an item in")
SWorld.setState(gs.world, bx, by, bz + 1, 54 * 16)
H.run(0.3)
camera.CFrame = Mock.CFrame.new(eye, Mock.Vector3.new((bx + 0.5) * BS, (by + 0.5) * BS, (bz + 1.2) * BS))
UIS.InputBegan:Fire(MB2, false)
H.run(0.1)
UIS.InputEnded:Fire(MB2)
H.run(0.5)
local cgui = player.PlayerGui:FindFirstChild("mclceContainer")
check(cgui ~= nil and cgui.Enabled == true, "chest screen opened")
if cgui and cgui.Enabled then
	-- click the first inventory slot that holds something, then chest slot 1
	local SBE = H.caches.server["src/shared/Sim/BlockEntities.luau"]
	local slot
	for i = 1, 36 do
		if sp.inventory.slots[i] then
			slot = i
			break
		end
	end
	local buttons = {}
	for _, c in cgui:GetDescendants() do
		if c.ClassName == "TextButton" then
			table.insert(buttons, c)
		end
	end
	-- buttons are created in order: 27 container slots, then inventory 1..36
	buttons[27 + slot].Activated:Fire()
	H.run(0.2)
	buttons[1].Activated:Fire()
	H.run(0.3)
	local e = SBE.get(gs.world, bx, by, bz + 1)
	check(e ~= nil and e.slots[1] ~= nil, "item moved into the chest via UI")
	check(string.find(buttons[1].Text, "") ~= nil and buttons[1].Text ~= "", "chest slot shows the item: " .. buttons[1].Text)
	UIS.InputBegan:Fire({ UserInputType = Mock.Enum.UserInputType.Keyboard, KeyCode = Mock.Enum.KeyCode.E }, false)
	H.run(0.3)
	check(cgui.Enabled == false, "E closes the chest")
end

print("[mock] Legacy crafting screen: open, switch tab, craft planks")
local function key(k)
	UIS.InputBegan:Fire({ UserInputType = Mock.Enum.UserInputType.Keyboard, KeyCode = Mock.Enum.KeyCode[k] }, false)
	H.run(0.1)
end
SInventory.add(sp.inventory, SItemStack.new(17, 2))
sp.inventory.version += 1
H.run(0.3)
key("C")
local lm = player.PlayerGui:FindFirstChild("mclceLegacyMenus")
check(lm ~= nil and lm.Crafting.Visible == true, "crafting screen opens with C")
-- planks are in "materials" (last tab): tabPrev wraps there
key("Q")
check(lm.Crafting.Tab7.TextColor3.R == 1, "materials tab highlighted")
local before = SInventory.count(sp.inventory, 5)
key("Return")
H.run(0.3)
check(SInventory.count(sp.inventory, 5) == before + 4, "crafted 4 planks via the menu (" .. SInventory.count(sp.inventory, 5) .. ")")
key("Backspace")
check(lm.Crafting.Visible == false, "back closes crafting")
key("P")
check(lm.Pause.Visible == true, "pause menu opens")
key("Down")
key("Up")
key("Return")
check(lm.Pause.Visible == false, "resume closes pause")

print("[mock] chat: host command via the chat box")
do
	key("T")
	local chatGui = player.PlayerGui:FindFirstChild("mclceChat")
	check(chatGui ~= nil and chatGui.Input.Visible, "T opens the chat box")
	chatGui.Input.Text = "/time set night"
	chatGui.Input.FocusLost:Fire(true)
	H.run(0.3)
	check(gs.worldTime >= 13000 and gs.worldTime < 13100, "command ran on the server (time " .. gs.worldTime .. ")")
	check(string.find(chatGui.Log.Text, "Time set") ~= nil, "reply shown in the chat log")
end

print("[mock] inventory screen: equip a helmet with the d-pad")
do
	sp.inventory.slots[sp.inventory.selected] = nil
	SInventory.add(sp.inventory, SItemStack.new(306, 1)) -- iron helmet -> lands in a hotbar slot
	sp.inventory.version += 1
	H.run(0.3)
	local helmetSlot
	for i = 1, 36 do
		if sp.inventory.slots[i] and sp.inventory.slots[i].id == 306 then
			helmetSlot = i
		end
	end
	key("I")
	local inv = player.PlayerGui:FindFirstChild("mclceInventory")
	check(inv ~= nil and inv.Enabled, "inventory screen opens with I")
	-- click the helmet's slot, then the helmet armour slot
	local function slotButton(id)
		for _, d in inv:GetDescendants() do
			if d.Name == "Slot" .. tostring(id) then
				return d
			end
		end
	end
	slotButton(helmetSlot).Activated:Fire()
	H.run(0.2)
	slotButton(37).Activated:Fire()
	H.run(0.3)
	check(sp.inventory.slots[37] and sp.inventory.slots[37].id == 306, "helmet equipped")
	key("I")
	check(inv.Enabled == false, "I closes the inventory")
end

print("[mock] creative palette: /gamemode creative, I, pick an item")
do
	local chatGui = player.PlayerGui:FindFirstChild("mclceChat")
	key("T")
	chatGui.Input.Text = "/gamemode creative"
	chatGui.Input.FocusLost:Fire(true)
	H.run(0.3)
	check(sp.gamemode == "creative", "server switched to creative")
	key("I")
	local cg = player.PlayerGui:FindFirstChild("mclceCreative")
	check(cg ~= nil and cg.Enabled, "creative palette opens with I in creative")
	local inv = player.PlayerGui:FindFirstChild("mclceInventory")
	check(inv.Enabled == false, "survival inventory stays closed in creative")
	key("R") -- next tab: decoration
	key("Return")
	H.run(0.3)
	local held = sp.inventory.slots[sp.inventory.selected]
	check(held ~= nil and held.count > 1, "creative take filled the hotbar slot (" .. (held and held.id .. " x" .. held.count or "nil") .. ")")
	local cell
	for _, d in cg:GetDescendants() do
		if d.Name == "Cell3" then
			cell = d
		end
	end
	cell.Activated:Fire()
	H.run(0.3)
	local held2 = sp.inventory.slots[sp.inventory.selected]
	check(held2 ~= nil and (held2.id ~= held.id or held2.meta ~= held.meta), "clicking a cell takes that item")
	key("I")
	check(cg.Enabled == false, "I closes the palette")
	key("T")
	chatGui.Input.Text = "/gamemode survival"
	chatGui.Input.FocusLost:Fire(true)
	H.run(0.3)
	check(sp.gamemode == "survival", "back to survival")
end

print("[mock] nether portal: light with flint & steel, step in, arrive")
do
	local px, py, pz = bx, by, bz + 3
	-- clear a corridor between the player and the frame (chest etc. from earlier steps)
	for x = bx - 1, bx + 2 do
		for z = bz + 1, bz + 2 do
			SWorld.setState(gs.world, x, py - 1, z, 1 * 16)
			for y = py, py + 3 do
				SWorld.setState(gs.world, x, y, z, 0)
			end
		end
	end
	for i = -1, 2 do
		SWorld.setState(gs.world, px + i, py - 1, pz, 49 * 16)
		SWorld.setState(gs.world, px + i, py + 3, pz, 49 * 16)
	end
	for j = 0, 2 do
		SWorld.setState(gs.world, px - 1, py + j, pz, 49 * 16)
		SWorld.setState(gs.world, px + 2, py + j, pz, 49 * 16)
		SWorld.setState(gs.world, px, py + j, pz, 0)
		SWorld.setState(gs.world, px + 1, py + j, pz, 0)
	end
	sp.inventory.slots[sp.inventory.selected] = SItemStack.new(259, 1)
	sp.inventory.version += 1
	sp.portalCooldown = 0
	H.run(0.4)
	-- aim at the top face of the frame's bottom block, through the opening
	camera.CFrame = Mock.CFrame.new(eye, Mock.Vector3.new((px + 0.5) * BS, py * BS, (pz + 0.6) * BS))
	UIS.InputBegan:Fire(MB2, false)
	H.run(0.1)
	UIS.InputEnded:Fire(MB2)
	H.run(0.3)
	check(SWorld.getId(gs.world, px, py, pz) == 90, "portal lit by right-clicking with flint & steel")
	-- walk into the portal (no physics in the mock: move the character)
	root.Anchored = false
	root.CFrame = Mock.CFrame.new((px + 0.5) * BS, py * BS + 3, (pz + 0.5) * BS)
	H.run(5)
	local ccw = H.sideG.client.mclceClient.cw
	local dims = H.sideG.server.mclceServer.dims
	check(dims.where[1001] == "nether", "server moved the player to the Nether")
	check(ccw.dimension == "nether", "client switched to the Nether world")
	check(ccw.world.chunkCount > 5, "nether chunks streamed: " .. ccw.world.chunkCount)
	H.run(3)
	check(root.Anchored == false, "re-anchored on arrival, released after HELLO")
end

print("[mock] autosave + shutdown")
H.run(31)
check(H.dsCalls.set > 0, "autosave wrote to DataStore (sets=" .. H.dsCalls.set .. ")")
for _, fn in H.closeHandlers do
	Mock.task.spawn(fn)
end
H.run(5)
local store = H.stores["mclce_world_v1"]
check(store ~= nil and store["default/meta"] ~= nil, "world meta saved")
check(store ~= nil and store["default/p/1001"] ~= nil, "player record saved on shutdown")

for _, l in Mock.log do
	print("  log " .. l)
end
if #Mock.errors > 0 then
	for _, e in Mock.errors do
		print("SCRIPT ERROR: " .. e)
	end
end
print(string.format("[mock] remote msgs to client=%d (%.1f KB buffers), to server=%d; datastore gets=%d sets=%d",
	Mock.remoteTraffic.toClient, Mock.remoteTraffic.bytesToClient / 1024, Mock.remoteTraffic.toServer, H.dsCalls.get, H.dsCalls.set))
local failed = H.failures() + #Mock.errors
print(failed == 0 and "[mock] PASS" or ("[mock] FAILED (" .. failed .. ")"))
if failed > 0 then
	error("roblox mock session failed", 0)
end
